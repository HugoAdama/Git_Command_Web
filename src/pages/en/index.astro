---
// src/pages/en/index.astro
import Layout from '@/layouts/Layout.astro';
import {
  Header,
  NavigationSections,
  GitPipeline,
  TopicTabs,
  SearchBar,
  CommandPanel,
  InteractiveTerminal,
  BranchVisualizer,
  ConflictResolver,
  GitBisectSimulator,
  GitRescueSection,
  WorkflowsSection,
  ComparisonsSection,
  CommandBuilder,
  ConventionalCommitBuilder,
  GitignoreBuilder,
  GitAliasesVault,
  GitHooksHub,
  GitInternals,
  GitGlossary,
  GitQuiz,
  Footer
} from '@/components';
---

<Layout
  title="Git Commands | Interactive Educational Guide: How Your Changes Travel"
  description="Learn Git visually: Interactive 4-stage pipeline, live bash simulator, branch visualizer, conflict resolution, git bisect, pro aliases, git hooks, internal architecture, glossary and quiz."
  lang="en"
>
  <Header lang="en" />

  <!-- Interactive Workspace Hub Navigation -->
  <NavigationSections lang="en" />

  <!-- Hub Content Views -->
  <main class="hub-content-area">
    <!-- View 1: Pipeline & Command Reference -->
    <div class="hub-view-container" id="view-pipeline" data-view-id="pipeline">
      <section id="seccion-pipeline" class="view-section" aria-label="Interactive pipeline and command finder">
        <GitPipeline lang="en" />
        <TopicTabs lang="en" />
        <SearchBar lang="en" />
        <CommandPanel lang="en" />
      </section>
    </div>

    <!-- View 2: Visual Simulators (Terminal, Branch Tree, Conflict Resolver & Bisect) -->
    <div class="hub-view-container" id="view-simuladores" data-view-id="simuladores" hidden>
      <InteractiveTerminal lang="en" />
      <BranchVisualizer lang="en" />
      <ConflictResolver lang="en" />
      <GitBisectSimulator lang="en" />
    </div>

    <!-- View 3: Practical Guides & Emergency Rescue -->
    <div class="hub-view-container" id="view-guias" data-view-id="guias" hidden>
      <GitRescueSection lang="en" />
      <WorkflowsSection lang="en" />
      <ComparisonsSection lang="en" />
    </div>

    <!-- View 4: Builders, Pro Aliases & Git Hooks -->
    <div class="hub-view-container" id="view-herramientas" data-view-id="herramientas" hidden>
      <CommandBuilder lang="en" />
      <ConventionalCommitBuilder lang="en" />
      <GitignoreBuilder lang="en" />
      <GitAliasesVault lang="en" />
      <GitHooksHub lang="en" />
    </div>

    <!-- View 5: Internal Architecture, Glossary & Interactive Quiz -->
    <div class="hub-view-container" id="view-glosario-quiz" data-view-id="glosario-quiz" hidden>
      <GitInternals lang="en" />
      <GitGlossary lang="en" />
      <GitQuiz lang="en" />
    </div>
  </main>

  <Footer lang="en" />
</Layout>

<style>
  .hub-content-area {
    min-height: 480px;
    position: relative;
  }

  .hub-view-container {
    animation: fadeInView 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hub-view-container[hidden] {
    display: none;
  }

  @keyframes fadeInView {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hub-view-container {
      animation: none;
    }
  }

  .view-section {
    scroll-margin-top: 5rem;
  }
</style>

<script>
  import '@/scripts/mainApp';
</script>
