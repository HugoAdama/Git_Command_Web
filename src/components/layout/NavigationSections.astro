---
// NavigationSections.astro
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';
---

<nav class="hub-navigation" aria-label={isEn ? "Educational modules navigation" : "Navegación de módulos didácticos"}>
  <div class="hub-nav-top">
    <!-- 5 Clean Segmented Workspace Tabs -->
    <div class="hub-tabs-list" role="tablist" aria-label={isEn ? "Content modules" : "Módulos de contenido"}>
      <button
        type="button"
        class="hub-tab-btn active"
        role="tab"
        data-view="pipeline"
        aria-selected="true"
        aria-controls="view-pipeline"
        id="tab-view-pipeline"
        title={isEn ? "1. Interactive pipeline and phase commands" : "1. Pipeline interactivo y comandos por fases"}
      >
        <span class="hub-tab-num" aria-hidden="true">1</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="10 8 16 12 10 16 10 8"></polygon>
        </svg>
        <span class="hub-tab-text">Pipeline</span>
      </button>

      <button
        type="button"
        class="hub-tab-btn"
        role="tab"
        data-view="simuladores"
        aria-selected="false"
        aria-controls="view-simuladores"
        id="tab-view-simuladores"
        title={isEn ? "2. Interactive simulators: Terminal, Branch tree, Conflicts, Git bisect & Rebase playground" : "2. Simuladores interactivos: Terminal, Ramas, Conflictos, Git Bisect y Rebase"}
      >
        <span class="hub-tab-num" aria-hidden="true">2</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="4 17 10 11 4 5"></polyline>
          <line x1="12" y1="19" x2="20" y2="19"></line>
        </svg>
        <span class="hub-tab-text">{isEn ? 'Simulators' : 'Simuladores'}</span>
      </button>

      <button
        type="button"
        class="hub-tab-btn"
        role="tab"
        data-view="guias"
        aria-selected="false"
        aria-controls="view-guias"
        id="tab-view-guias"
        title={isEn ? "3. Git SOS emergency rescue, team workflows & comparisons" : "3. Modo Rescate Git SOS, flujos en equipo y comparativas"}
      >
        <span class="hub-tab-num" aria-hidden="true">3</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span class="hub-tab-text">{isEn ? 'Guides & SOS' : 'Guías & SOS'}</span>
      </button>

      <button
        type="button"
        class="hub-tab-btn"
        role="tab"
        data-view="herramientas"
        aria-selected="false"
        aria-controls="view-herramientas"
        id="tab-view-herramientas"
        title={isEn ? "4. Pro toolkit: Builders, Aliases vault & automated Git Hooks" : "4. Herramientas Pro: Generadores, Bóveda de Aliases y Git Hooks"}
      >
        <span class="hub-tab-num" aria-hidden="true">4</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <span class="hub-tab-text">{isEn ? 'Toolkit & Pro' : 'Herramientas Pro'}</span>
      </button>

      <button
        type="button"
        class="hub-tab-btn"
        role="tab"
        data-view="glosario-quiz"
        aria-selected="false"
        aria-controls="view-glosario-quiz"
        id="tab-view-glosario-quiz"
        title={isEn ? "5. Under the hood architecture, visual glossary & interactive quiz" : "5. Arquitectura interna (DAG), Glosario didáctico y mini Quiz"}
      >
        <span class="hub-tab-num" aria-hidden="true">5</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span class="hub-tab-text">{isEn ? 'Internals & Quiz' : 'Internals & Quiz'}</span>
      </button>
    </div>

    <!-- Toggle View Mode: Compact Tabs vs Show All -->
    <button
      type="button"
      id="toggle-view-mode"
      class="view-mode-btn"
      title={isEn ? "Toggle between compact tabs or continuous view" : "Alternar entre vista compacta por pestañas o ver todo el contenido continuo"}
      aria-pressed="false"
      data-label-tabs={isEn ? "Tabbed view" : "Vista pestañas"}
      data-label-all={isEn ? "Show all" : "Ver todo"}
    >
      <svg class="icon-tabs-mode" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="3" y1="9" x2="21" y2="9"></line>
        <line x1="9" y1="21" x2="9" y2="9"></line>
      </svg>
      <span id="view-mode-label">{isEn ? 'Show all' : 'Ver todo'}</span>
    </button>
  </div>
</nav>

<style>
  .hub-navigation {
    position: sticky;
    top: 0.75rem;
    z-index: 50;
    margin: 1.25rem 0 2rem;
    width: 100%;
  }

  .hub-nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-medium);
    border-radius: 9999px;
    box-shadow: var(--shadow-md);
    width: 100%;
    box-sizing: border-box;
  }

  .hub-tabs-list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex: 1;
    min-width: 0;
  }

  .hub-tab-btn {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.45rem 0.75rem;
    border-radius: 9999px;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    flex: 1;
    text-align: center;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hub-tab-btn:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.06);
  }

  .hub-tab-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .hub-tab-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Active Hub Tab */
  .hub-tab-btn.active,
  .hub-tab-btn[aria-selected="true"] {
    background: var(--accent-cyan);
    color: #070b14;
    font-weight: 700;
    box-shadow: 0 0 15px -2px var(--glow-cyan);
  }

  .hub-tab-btn.active .hub-tab-num {
    background: #070b14;
    color: var(--accent-cyan);
  }

  :global([data-theme="light"]) .hub-tab-btn.active {
    background: var(--accent-cyan);
    color: #ffffff;
  }
  :global([data-theme="light"]) .hub-tab-btn.active .hub-tab-num {
    background: #ffffff;
    color: var(--accent-cyan);
  }

  /* View Mode Toggle Button */
  .view-mode-btn {
    all: unset;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .view-mode-btn:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--border-medium);
  }

  .view-mode-btn.active-all {
    background: rgba(250, 204, 21, 0.15);
    border-color: var(--accent-gold);
    color: var(--accent-gold);
  }

  /* Responsive handling */
  @media (max-width: 992px) {
    .hub-tabs-list {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .hub-tabs-list::-webkit-scrollbar {
      display: none;
    }
    .hub-tab-btn {
      flex: 0 0 auto;
      padding: 0.4rem 0.75rem;
    }
  }

  @media (max-width: 680px) {
    .hub-tab-num {
      display: none;
    }
    .hub-tab-btn {
      font-size: 0.8rem;
      padding: 0.35rem 0.65rem;
      gap: 0.35rem;
    }
    .view-mode-btn span {
      display: none;
    }
    .view-mode-btn {
      padding: 0.4rem 0.55rem;
    }
  }
</style>

<script>
  // Hub Navigation and View Switcher Logic
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.hub-tab-btn');
  const viewPanels = document.querySelectorAll<HTMLElement>('.hub-view-container');
  const toggleViewModeBtn = document.getElementById('toggle-view-mode');
  const viewModeLabel = document.getElementById('view-mode-label');

  let isShowAllMode = false;

  export function switchHubView(viewName: string, shouldScroll = true): void {
    if (isShowAllMode) {
      // If user was in "show all" mode, switch back to tabbed mode
      toggleViewMode(false);
    }

    const updateDOM = () => {
      tabBtns.forEach(btn => {
        const match = btn.getAttribute('data-view') === viewName;
        btn.classList.toggle('active', match);
        btn.setAttribute('aria-selected', match ? 'true' : 'false');
      });

      viewPanels.forEach(panel => {
        const panelView = panel.getAttribute('data-view-id');
        panel.hidden = panelView !== viewName;
      });
    };

    if ('startViewTransition' in document) {
      (document as any).startViewTransition(updateDOM);
    } else {
      updateDOM();
    }

    // Update URL hash without jumping
    if (history.replaceState) {
      history.replaceState(null, '', `#${viewName}`);
    }

    if (shouldScroll) {
      const targetEl = document.getElementById(`view-${viewName}`);
      if (targetEl && window.scrollY > 300) {
        window.scrollTo({
          top: targetEl.offsetTop - 90,
          behavior: 'smooth'
        });
      }
    }
  }

  function toggleViewMode(forceState?: boolean): void {
    isShowAllMode = forceState !== undefined ? forceState : !isShowAllMode;

    if (toggleViewModeBtn && viewModeLabel) {
      toggleViewModeBtn.classList.toggle('active-all', isShowAllMode);
      viewModeLabel.textContent = isShowAllMode ? 'Vista pestañas' : 'Ver todo';
    }

    if (isShowAllMode) {
      // Unhide all views
      viewPanels.forEach(panel => {
        panel.hidden = false;
      });
      tabBtns.forEach(b => b.classList.remove('active'));
    } else {
      // Restore active tab
      const currentActive = document.querySelector<HTMLButtonElement>('.hub-tab-btn[aria-selected="true"]');
      const view = currentActive?.getAttribute('data-view') || 'pipeline';
      switchHubView(view, false);
    }
  }

  // Click listeners on hub tabs
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.getAttribute('data-view');
      if (view) switchHubView(view);
    });
  });

  // Toggle view mode click listener
  if (toggleViewModeBtn) {
    toggleViewModeBtn.addEventListener('click', () => {
      toggleViewMode();
    });
  }

  // Keyboard shortcuts [1] to [5]
  window.addEventListener('keydown', (e: KeyboardEvent) => {
    const activeTag = (document.activeElement?.tagName || '').toLowerCase();
    if (activeTag === 'input' || activeTag === 'textarea' || activeTag === 'select') return;

    const keyMap: Record<string, string> = {
      '1': 'pipeline',
      '2': 'simuladores',
      '3': 'guias',
      '4': 'herramientas',
      '5': 'glosario-quiz'
    };

    if (keyMap[e.key]) {
      e.preventDefault();
      switchHubView(keyMap[e.key]);
    }
  });

  // Listen to hash changes or initial URL hash
  function checkInitialHash(): void {
    const hash = window.location.hash.replace('#', '');
    const validViews = ['pipeline', 'simuladores', 'guias', 'herramientas', 'glosario-quiz'];
    if (validViews.includes(hash)) {
      switchHubView(hash, false);
    } else {
      switchHubView('pipeline', false);
    }
  }

  if (typeof window !== 'undefined') {
    checkInitialHash();
    window.addEventListener('hashchange', checkInitialHash);
  }
</script>
