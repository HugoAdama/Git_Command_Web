---
// Footer.astro
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';
---

<footer class="site-footer">
  <div class="footer-card">
    <div class="footer-columns">
      <!-- Col 1: Brand & Author attribution -->
      <div class="footer-brand-col">
        <div class="footer-logo">
          <div class="footer-logo-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="6" y1="3" x2="6" y2="21"></line>
              <path d="M6 16c4 0 11-1 11-7"></path>
              <circle cx="6" cy="18" r="2.8" fill="var(--bg-primary)" stroke="var(--accent-cyan)" stroke-width="2.2"></circle>
              <circle cx="6" cy="6" r="2.8" fill="var(--bg-primary)" stroke="var(--accent-cyan)" stroke-width="2.2"></circle>
              <circle cx="17" cy="8" r="2.8" fill="var(--bg-primary)" stroke="var(--accent-emerald)" stroke-width="2.2"></circle>
            </svg>
          </div>
          <b class="footer-title">Git Command Web</b>
        </div>
        <p class="footer-tagline">
          {isEn
            ? 'Interactive visual reference and mental model guide for modern software engineers.'
            : 'Referencia visual interactiva y modelo mental para desarrolladores de software.'}
        </p>

        <!-- Prominent Author Attribution Badge -->
        <a
          href="https://github.com/HugoAdama/Git_Command_Web"
          target="_blank"
          rel="noopener noreferrer"
          class="author-badge-card"
          title={isEn ? "Visit Hugo Adama's Git Command Web Repository on GitHub" : "Visitar el repositorio de Hugo Adama en GitHub"}
        >
          <div class="author-avatar-wrap" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
          </div>
          <div class="author-text-meta">
            <span class="author-label-small">{isEn ? 'Created & Developed by' : 'Creado y Desarrollado por'}</span>
            <div class="author-name-row">
              <strong class="author-name-highlight">Hugo Adama</strong>
              <svg class="author-external-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </div>
          </div>
        </a>
      </div>

      <!-- Col 2: Golden Rule -->
      <div class="footer-tips-col">
        <h3 class="tips-heading">{isEn ? 'Git Golden Rule' : 'Regla de oro de Git'}</h3>
        <p class="tip-body">
          <svg class="tip-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          {isEn ? (
            <>Always inspect with <code>git status</code> and <code>git diff</code> before staging, and verify with <code>git log --oneline</code> before pushing.</>
          ) : (
            <>Inspecciona siempre con <code>git status</code> y <code>git diff</code> antes de preparar cambios, y verifica con <code>git log --oneline</code> antes de hacer push.</>
          )}
        </p>
      </div>

      <!-- Col 3: Keyboard Shortcuts -->
      <div class="footer-shortcuts-col">
        <h3 class="tips-heading">{isEn ? 'Keyboard Shortcuts' : 'Atajos rápidos'}</h3>
        <ul class="shortcuts-list">
          <li><kbd>/</kbd> {isEn ? 'or' : 'o'} <kbd>Ctrl+K</kbd> <span>{isEn ? 'Quick search' : 'Buscar comando'}</span></li>
          <li><kbd>Tab</kbd> + <kbd>Enter</kbd> <span>{isEn ? 'Navigate & copy' : 'Navegar y copiar'}</span></li>
          <li><kbd>1</kbd> - <kbd>5</kbd> <span>{isEn ? 'Switch workspace view' : 'Cambiar de módulo'}</span></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-meta-left">
        <p class="copyright">
          © {new Date().getFullYear()} Git Command Web — {isEn ? 'Open Source MIT License' : 'Código Abierto Licencia MIT'} · {isEn ? 'Developed by' : 'Desarrollado por'} <a href="https://github.com/HugoAdama/Git_Command_Web" target="_blank" rel="noopener noreferrer" class="footer-repo-link">Hugo Adama</a>
        </p>
      </div>
      <div class="footer-badges">
        <span class="tech-badge badge-astro">Astro v7</span>
        <span class="tech-badge">Vanilla CSS</span>
        <span class="tech-badge">Bilingual i18n</span>
        <span class="tech-badge">Clean Architecture</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 2.5rem 0 6.5rem;
  }

  .footer-card {
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-medium);
    border-radius: 1.25rem;
    padding: 2.25rem 2rem;
    box-shadow: var(--shadow-md);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: 1.6fr 1.4fr 1fr;
    gap: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .footer-logo-icon {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.15), rgba(168, 85, 247, 0.15));
    border: 1px solid rgba(56, 189, 248, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan);
    box-shadow: 0 0 15px -3px var(--glow-cyan);
    flex-shrink: 0;
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.01em;
  }

  .footer-tagline {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 34ch;
  }

  /* Author Badge Card */
  .author-badge-card {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.85rem;
    background: rgba(56, 189, 248, 0.06);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 0.75rem;
    width: fit-content;
    margin-top: 0.25rem;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .author-badge-card:hover {
    background: rgba(56, 189, 248, 0.12);
    border-color: var(--accent-cyan);
    transform: translateY(-2px);
    box-shadow: 0 4px 18px -3px var(--glow-cyan);
  }

  .author-avatar-wrap {
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    background: rgba(56, 189, 248, 0.15);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-text-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .author-label-small {
    font-size: 0.7rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .author-name-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .author-name-highlight {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent-cyan);
    letter-spacing: 0.01em;
  }

  .author-external-icon {
    color: var(--accent-cyan);
    opacity: 0.75;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .author-badge-card:hover .author-external-icon {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .footer-repo-link {
    color: var(--accent-cyan);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .footer-repo-link:hover {
    text-decoration: underline;
    color: #f8fafc;
  }

  .tips-heading {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-main);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .tip-body {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .tip-icon {
    display: inline-block;
    vertical-align: -3px;
    color: var(--accent-gold);
    margin-right: 0.35rem;
  }

  .tip-body code {
    font-family: var(--font-mono);
    color: var(--accent-gold);
    background: rgba(250, 204, 21, 0.1);
    border: 1px solid rgba(250, 204, 21, 0.2);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.8rem;
  }

  .shortcuts-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .shortcuts-list li {
    font-size: 0.825rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  kbd {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-medium);
    color: var(--text-main);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .copyright {
    font-size: 0.825rem;
    color: var(--text-dim);
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-badge {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-dim);
    transition: border-color 0.2s, color 0.2s;
  }

  .tech-badge:hover {
    border-color: var(--border-medium);
    color: var(--text-muted);
  }

  .badge-astro {
    border-color: rgba(168, 85, 247, 0.3);
    color: #c084fc;
    background: rgba(168, 85, 247, 0.08);
  }

  @media (max-width: 960px) {
    .footer-columns {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding: 1.5rem 0 5.5rem;
    }

    .footer-card {
      padding: 1.5rem 1.15rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
