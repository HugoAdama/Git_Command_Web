---
// Footer.astro
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';
---

<footer class="site-footer">
  <div class="footer-card">
    <div class="footer-columns">
      <div class="footer-brand-col">
        <div class="footer-logo">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <line x1="6" y1="3" x2="6" y2="15"></line>
            <circle cx="18" cy="6" r="3"></circle>
            <circle cx="6" cy="18" r="3"></circle>
            <path d="M18 9a9 9 0 0 1-9 9"></path>
          </svg>
          <b>Git Flow Cheat Sheet</b>
        </div>
        <p class="footer-tagline">
          {isEn
            ? 'Fast interactive visual reference for modern software engineers built on Astro 7.'
            : 'Referencia interactiva rápida para desarrolladores modernos construida sobre Astro 7.'}
        </p>
      </div>

      <div class="footer-tips-col">
        <h3 class="tips-heading">{isEn ? 'Git Golden Rule' : 'Regla de oro del flujo de Git'}</h3>
        <p class="tip-body">
          <svg class="tip-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="9" y1="18" x2="15" y2="18"></line>
            <line x1="10" y1="22" x2="14" y2="22"></line>
            <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path>
          </svg>
          {isEn ? (
            <>Always run <code>git status</code> and <code>git diff</code> before staging, and verify with <code>git log --oneline</code> before pushing.</>
          ) : (
            <>Siempre ejecuta <code>git status</code> y <code>git diff</code> antes de preparar cambios, y comprueba con <code>git log --oneline</code> antes de hacer push.</>
          )}
        </p>
      </div>

      <div class="footer-shortcuts-col">
        <h3 class="tips-heading">{isEn ? 'Keyboard Shortcuts' : 'Atajos rápidos'}</h3>
        <ul class="shortcuts-list">
          <li><kbd>/</kbd> {isEn ? 'or' : 'o'} <kbd>Ctrl+K</kbd> <span>{isEn ? 'Quick search' : 'Buscar comando'}</span></li>
          <li><kbd>Tab</kbd> + <kbd>Enter</kbd> <span>{isEn ? 'Navigate & copy' : 'Navegar y copiar'}</span></li>
          <li><kbd>1</kbd> - <kbd>5</kbd> <span>{isEn ? 'Switch modules' : 'Cambiar de módulo'}</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-credits">
        <p class="copyright">
          © {new Date().getFullYear()} Git Command Web — {isEn ? 'Optimized for' : 'Migrado y optimizado para'} <strong>Astro 7</strong>
        </p>
        <div class="author-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span class="author-label">{isEn ? 'Developed by' : 'Desarrollado por'}</span>
          <strong class="author-name">Hugo Adama</strong>
        </div>
      </div>
      <div class="footer-badges">
        <span class="tech-badge">Astro v7</span>
        <span class="tech-badge">Vanilla CSS</span>
        <span class="tech-badge">Bilingual i18n</span>
        <span class="tech-badge">Clean Architecture</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 1rem 0 3.5rem;
  }

  .footer-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 1.25rem;
    padding: 2rem 1.75rem;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: 1.5fr 1.5fr 1fr;
    gap: 2rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--accent-cyan);
    margin-bottom: 0.5rem;
  }

  .footer-tagline {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 32ch;
  }

  .tips-heading {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-main);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.6rem;
  }

  .tip-body {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .tip-icon {
    display: inline-block;
    vertical-align: -3px;
    color: var(--accent-gold);
    margin-right: 0.25rem;
  }

  .tip-body code {
    font-family: var(--font-mono);
    color: var(--accent-gold);
    background: rgba(250, 204, 21, 0.1);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  .shortcuts-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .shortcuts-list li {
    font-size: 0.825rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  kbd {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-medium);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-credits {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .copyright {
    font-size: 0.825rem;
    color: var(--text-dim);
  }

  .copyright strong {
    color: var(--accent-cyan);
  }

  .author-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  .author-tag svg {
    color: var(--accent-cyan);
    flex-shrink: 0;
  }

  .author-label {
    color: var(--text-dim);
  }

  .author-name {
    color: var(--accent-cyan);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-badge {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-dim);
  }

  @media (max-width: 860px) {
    .footer-columns {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-card {
      padding: 1.5rem 1.15rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>
