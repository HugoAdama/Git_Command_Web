---
// GitPipeline.astro
import { gitStages as gitStagesEs } from '../data/gitData';
import { gitStagesEn } from '../data/en/gitData';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const stages = isEn ? gitStagesEn : gitStagesEs;
---

<section class="pipeline-section" aria-label={isEn ? "Interactive Git lifecycle flow diagram" : "Diagrama interactivo de flujo de Git"}>
  <div class="pipeline-header">
    <div class="pipeline-label">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polygon points="10 8 16 12 10 16 10 8"></polygon>
      </svg>
      <span>{isEn ? 'Changes Transport Pipeline' : 'Pipeline de Transporte de Cambios'}</span>
    </div>
    <span class="pipeline-hint">{isEn ? 'Select any action arrow to inspect exact commands' : 'Selecciona una acción para ver sus comandos'}</span>
  </div>

  <div class="pipeline-container" role="tablist" aria-label={isEn ? "Interactive change transport journey" : "Recorrido interactivo de cambios"}>
    <!-- Horizontal Forward Flow -->
    <div class="pipeline-main-row">
      <!-- Node 0: Carpeta de trabajo -->
      <div class="node-wrapper" data-node-index="0">
        <div class="node" id="node-0">
          <div class="node-badge">01</div>
          <div class="node-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <div class="node-info">
            <b class="node-title">{stages[0].title}</b>
            <small class="node-sub">{stages[0].subtitle}</small>
          </div>
        </div>
      </div>

      <!-- Hop: git add -->
      <div class="hop-wrapper">
        <button
          type="button"
          class="hop-btn hop-add active"
          role="tab"
          data-target="add"
          data-from="0"
          data-to="1"
          aria-selected="true"
          aria-controls="panel-add"
          id="tab-add"
        >
          <span class="hop-tag">git add</span>
          <div class="hop-arrow" aria-hidden="true">
            <div class="arrow-line">
              <span class="pulse-beam"></span>
            </div>
            <div class="arrow-head"></div>
          </div>
        </button>
      </div>

      <!-- Node 1: Área de preparación -->
      <div class="node-wrapper" data-node-index="1">
        <div class="node" id="node-1">
          <div class="node-badge">02</div>
          <div class="node-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 11 12 14 22 4"></polyline>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
          </div>
          <div class="node-info">
            <b class="node-title">{stages[1].title}</b>
            <small class="node-sub">{stages[1].subtitle}</small>
          </div>
        </div>
      </div>

      <!-- Hop: git commit -->
      <div class="hop-wrapper">
        <button
          type="button"
          class="hop-btn hop-commit"
          role="tab"
          data-target="commit"
          data-from="1"
          data-to="2"
          aria-selected="false"
          aria-controls="panel-commit"
          id="tab-commit"
        >
          <span class="hop-tag">git commit</span>
          <div class="hop-arrow" aria-hidden="true">
            <div class="arrow-line">
              <span class="pulse-beam"></span>
            </div>
            <div class="arrow-head"></div>
          </div>
        </button>
      </div>

      <!-- Node 2: Repositorio local -->
      <div class="node-wrapper" data-node-index="2">
        <div class="node" id="node-2">
          <div class="node-badge">03</div>
          <div class="node-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"></circle>
              <line x1="1.05" y1="12" x2="7" y2="12"></line>
              <line x1="17.01" y1="12" x2="22.96" y2="12"></line>
            </svg>
          </div>
          <div class="node-info">
            <b class="node-title">{stages[2].title}</b>
            <small class="node-sub">{stages[2].subtitle}</small>
          </div>
        </div>
      </div>

      <!-- Hop: git push -->
      <div class="hop-wrapper">
        <button
          type="button"
          class="hop-btn hop-push"
          role="tab"
          data-target="push"
          data-from="2"
          data-to="3"
          aria-selected="false"
          aria-controls="panel-push"
          id="tab-push"
        >
          <span class="hop-tag">git push</span>
          <div class="hop-arrow" aria-hidden="true">
            <div class="arrow-line">
              <span class="pulse-beam"></span>
            </div>
            <div class="arrow-head"></div>
          </div>
        </button>
      </div>

      <!-- Node 3: Remoto -->
      <div class="node-wrapper" data-node-index="3">
        <div class="node" id="node-3">
          <div class="node-badge">04</div>
          <div class="node-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
            </svg>
          </div>
          <div class="node-info">
            <b class="node-title">{stages[3].title}</b>
            <small class="node-sub">{stages[3].subtitle}</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Return Loop: git pull -->
    <div class="pipeline-return-row">
      <button
        type="button"
        class="hop-btn hop-pull"
        role="tab"
        data-target="pull"
        data-from="3"
        data-to="0"
        aria-selected="false"
        aria-controls="panel-pull"
        id="tab-pull"
      >
        <div class="return-track" aria-hidden="true">
          <div class="return-line">
            <span class="pulse-beam reverse"></span>
          </div>
          <div class="return-arrow-head"></div>
        </div>
        <div class="return-content">
          <span class="return-badge">{isEn ? 'Return' : 'Retorno'}</span>
          <span class="hop-tag">git pull (fetch + merge)</span>
          <span class="return-desc">{isEn ? 'Downloads remote changes into your working directory' : 'Descarga cambios del remoto a tu carpeta de trabajo'}</span>
        </div>
      </button>
    </div>
  </div>
</section>

<style>
  .pipeline-section {
    margin: 2rem 0;
  }

  .pipeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding: 0 0.25rem;
  }

  .pipeline-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.825rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-cyan);
  }

  .pipeline-hint {
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .pipeline-container {
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: 1.25rem;
    padding: 1.75rem 1.25rem;
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
  }

  .pipeline-container::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(56, 189, 248, 0.4), rgba(250, 204, 21, 0.4), transparent);
  }

  .pipeline-main-row {
    display: grid;
    grid-template-columns: minmax(130px, 1fr) auto minmax(130px, 1fr) auto minmax(130px, 1fr) auto minmax(130px, 1fr);
    align-items: center;
    gap: 0.5rem;
  }

  /* Nodes */
  .node-wrapper {
    position: relative;
  }

  .node {
    background: var(--bg-secondary);
    border: 1.5px solid var(--border-medium);
    border-radius: 0.85rem;
    padding: 1rem 0.85rem;
    min-height: 7.2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .node-badge {
    position: absolute;
    top: 0.6rem;
    right: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .node-icon {
    width: 2.2rem;
    height: 2.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-muted);
    transition: all 0.25s ease;
  }

  .node-title {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.25;
    margin-top: 0.5rem;
  }

  .node-sub {
    display: block;
    font-size: 0.775rem;
    color: var(--text-muted);
    line-height: 1.3;
    margin-top: 0.2rem;
  }

  /* Node Active Glow States */
  .node.active-source {
    border-color: var(--accent-emerald);
    background: rgba(16, 185, 129, 0.08);
    box-shadow: 0 0 20px -3px rgba(16, 185, 129, 0.25);
  }
  .node.active-source .node-icon {
    color: var(--accent-emerald);
    background: rgba(16, 185, 129, 0.15);
  }

  .node.active-dest {
    border-color: var(--accent-cyan);
    background: rgba(56, 189, 248, 0.08);
    box-shadow: 0 0 20px -3px rgba(56, 189, 248, 0.25);
  }
  .node.active-dest .node-icon {
    color: var(--accent-cyan);
    background: rgba(56, 189, 248, 0.15);
  }

  /* Hops (Buttons) */
  .hop-wrapper {
    display: flex;
    justify-content: center;
  }

  .hop-btn {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.5rem;
    min-width: 6.75rem;
    border-radius: 0.75rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .hop-btn:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .hop-tag {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-secondary);
    padding: 0.25rem 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .hop-arrow {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
    padding: 0 0.15rem;
  }

  .arrow-line {
    flex: 1;
    height: 3px;
    background: var(--border-medium);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }

  .pulse-beam {
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(90deg, transparent, currentColor, transparent);
    opacity: 0;
  }

  .arrow-head {
    width: 0;
    height: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 8px solid var(--border-medium);
    transition: border-color 0.2s ease;
  }

  /* Active Hop States */
  .hop-btn.active .hop-tag,
  .hop-btn[aria-selected="true"] .hop-tag {
    color: #070b14;
    font-weight: 700;
    box-shadow: 0 0 15px -2px currentColor;
  }

  .hop-btn.active.hop-add .hop-tag {
    background: var(--accent-emerald);
    color: #070b14;
    border-color: var(--accent-emerald);
  }
  .hop-btn.active.hop-add .arrow-line {
    background: var(--accent-emerald);
  }
  .hop-btn.active.hop-add .arrow-head {
    border-left-color: var(--accent-emerald);
  }

  .hop-btn.active.hop-commit .hop-tag {
    background: var(--accent-gold);
    color: #070b14;
    border-color: var(--accent-gold);
  }
  .hop-btn.active.hop-commit .arrow-line {
    background: var(--accent-gold);
  }
  .hop-btn.active.hop-commit .arrow-head {
    border-left-color: var(--accent-gold);
  }

  .hop-btn.active.hop-push .hop-tag {
    background: var(--accent-cyan);
    color: #070b14;
    border-color: var(--accent-cyan);
  }
  .hop-btn.active.hop-push .arrow-line {
    background: var(--accent-cyan);
  }
  .hop-btn.active.hop-push .arrow-head {
    border-left-color: var(--accent-cyan);
  }

  .hop-btn.active .pulse-beam {
    opacity: 1;
    animation: beamFlow 1.4s infinite cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes beamFlow {
    0% { left: -50%; }
    100% { left: 120%; }
  }

  /* Return Row (Pull) */
  .pipeline-return-row {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border-subtle);
  }

  .hop-pull {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.85rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hop-pull:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--border-medium);
  }

  .return-track {
    display: flex;
    align-items: center;
    gap: 0;
    flex: 1;
    position: relative;
  }

  .return-line {
    flex: 1;
    height: 3px;
    background: var(--border-medium);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }

  .return-arrow-head {
    width: 0;
    height: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-right: 8px solid var(--border-medium);
    order: -1;
    margin-right: -1px;
    transition: border-color 0.2s ease;
  }

  .return-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .return-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    background: rgba(168, 85, 247, 0.15);
    color: var(--accent-purple);
    border: 1px solid rgba(168, 85, 247, 0.3);
    text-transform: uppercase;
  }

  .return-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Active Return Hop */
  .hop-pull.active,
  .hop-pull[aria-selected="true"] {
    background: rgba(168, 85, 247, 0.08);
    border-color: var(--accent-purple);
    box-shadow: 0 0 25px -5px rgba(168, 85, 247, 0.25);
  }

  .hop-pull.active .hop-tag {
    background: var(--accent-purple);
    color: #ffffff;
    border-color: var(--accent-purple);
  }

  .hop-pull.active .return-line {
    background: var(--accent-purple);
  }

  .hop-pull.active .return-arrow-head {
    border-right-color: var(--accent-purple);
  }

  .hop-pull.active .pulse-beam.reverse {
    opacity: 1;
    background: linear-gradient(90deg, transparent, #ffffff, transparent);
    animation: beamReverse 1.5s infinite linear;
  }

  @keyframes beamReverse {
    0% { right: -50%; left: auto; }
    100% { right: 120%; left: auto; }
  }

  /* Responsive Design */
  @media (max-width: 900px) {
    .pipeline-main-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .node {
      min-height: auto;
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      padding: 0.85rem 1rem;
    }

    .node-title {
      margin-top: 0;
    }

    .node-badge {
      position: static;
      margin-left: auto;
    }

    .hop-wrapper {
      justify-content: flex-start;
      padding-left: 2rem;
    }

    .hop-btn {
      flex-direction: row;
      min-width: 0;
      width: 100%;
      padding: 0.35rem 0.5rem;
      gap: 1rem;
    }

    .hop-arrow {
      width: auto;
      flex-direction: column;
      height: 2.25rem;
      align-items: center;
      padding: 0;
    }

    .arrow-line {
      width: 3px;
      height: 100%;
    }

    .arrow-head {
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      border-top: 8px solid var(--border-medium);
      border-bottom: 0;
    }

    .hop-btn.active.hop-add .arrow-head {
      border-top-color: var(--accent-emerald);
    }
    .hop-btn.active.hop-commit .arrow-head {
      border-top-color: var(--accent-gold);
    }
    .hop-btn.active.hop-push .arrow-head {
      border-top-color: var(--accent-cyan);
    }

    .return-content {
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .return-desc {
      width: 100%;
    }
  }
</style>
