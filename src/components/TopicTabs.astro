---
// TopicTabs.astro
import { gitTopics as gitTopicsEs } from '../data/gitData';
import { gitTopicsEn } from '../data/en/gitData';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const topics = isEn ? gitTopicsEn : gitTopicsEs;
---

<div class="topic-tabs-container">
  <div class="tabs-header">
    <div class="tabs-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
      <span>{isEn ? 'Supplementary Workflows' : 'Operaciones Complementarias'}</span>
    </div>
    <span class="tabs-hint">{isEn ? 'Day-to-day essential concepts' : 'Temas esenciales del día a día'}</span>
  </div>

  <div class="tabs-bar" role="tablist" aria-label={isEn ? "Supplementary Git topics" : "Temas complementarios"}>
    {topics.map((topic) => (
      <button
        type="button"
        class="topic-tab-btn"
        role="tab"
        data-target={topic.id}
        aria-selected="false"
        aria-controls={`panel-${topic.id}`}
        id={`tab-${topic.id}`}
      >
        <span class="tab-indicator" aria-hidden="true"></span>
        <span class="tab-label">{topic.title}</span>
        {topic.badge && <span class="tab-badge">{topic.badge}</span>}
      </button>
    ))}
  </div>
</div>

<style>
  .topic-tabs-container {
    margin: 1.75rem 0 2.25rem;
  }

  .tabs-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    padding: 0 0.25rem;
  }

  .tabs-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-gold);
  }

  .tabs-hint {
    font-size: 0.825rem;
    color: var(--text-dim);
  }

  .tabs-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .topic-tab-btn {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 1.25rem;
    border-radius: 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .topic-tab-btn:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-medium);
    color: var(--text-main);
    transform: translateY(-1px);
  }

  .tab-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-medium);
    transition: all 0.2s ease;
  }

  .tab-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-dim);
  }

  /* Active state */
  .topic-tab-btn.active,
  .topic-tab-btn[aria-selected="true"] {
    background: var(--bg-card-hover);
    border-color: var(--accent-gold);
    color: var(--text-main);
    box-shadow: 0 0 20px -3px var(--glow-gold);
  }

  .topic-tab-btn.active .tab-indicator,
  .topic-tab-btn[aria-selected="true"] .tab-indicator {
    background: var(--accent-gold);
    box-shadow: 0 0 8px var(--accent-gold);
  }

  .topic-tab-btn.active .tab-badge,
  .topic-tab-btn[aria-selected="true"] .tab-badge {
    background: rgba(250, 204, 21, 0.2);
    color: var(--accent-gold);
  }
</style>
