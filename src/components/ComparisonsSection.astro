---
// ComparisonsSection.astro
import { gitComparisons as gitComparisonsEs } from '../data/gitEducationalData';
import { gitComparisonsDataEn } from '../data/en/gitEducationalData';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const comparisons = isEn ? gitComparisonsDataEn : gitComparisonsEs;
---

<section id="seccion-comparativas" class="comparisons-section" aria-label={isEn ? "Git conceptual comparisons" : "Comparativas conceptuales de Git"}>
  <div class="section-title-wrap">
    <div class="section-badge badge-compare">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
        <line x1="8" y1="21" x2="16" y2="21"></line>
        <line x1="12" y1="17" x2="12" y2="21"></line>
      </svg>
      <span>{isEn ? 'Head to Head' : 'Frente a Frente'}</span>
    </div>
    <h2 class="section-heading">{isEn ? 'Head-to-Head Comparisons' : 'Comparativas Cara a Cara'}</h2>
    <p class="section-sub">
      {isEn
        ? 'Clear up common Git confusion. Understand key technical differences, pros/cons, and the exact moment to use each option.'
        : 'Aclara las confusiones más comunes en Git. Comprende las diferencias técnicas, ventajas y el momento exacto para usar cada alternativa.'}
    </p>
  </div>

  <!-- Comparison Tab Selector -->
  <div class="compare-tabs" role="tablist" aria-label={isEn ? "Select comparison topic" : "Seleccionar comparativa"}>
    {comparisons.map((item, idx) => (
      <button
        type="button"
        class={`compare-tab-btn ${idx === 0 ? 'active' : ''}`}
        data-cmp-id={item.id}
        role="tab"
        aria-selected={idx === 0 ? 'true' : 'false'}
      >
        <span>{item.title}</span>
      </button>
    ))}
  </div>

  <!-- Comparison Panels -->
  <div class="compare-panels">
    {comparisons.map((item, idx) => (
      <div
        class="compare-panel-card"
        id={`cmp-panel-${item.id}`}
        data-cmp-target={item.id}
        hidden={idx !== 0}
      >
        <div class="side-by-side-grid">
          <!-- Command A -->
          <div class="command-side side-a">
            <div class="side-header">
              <span class="side-badge">{isEn ? 'Option A' : 'Opción A'}</span>
              <h3 class="side-title"><code>{item.commandA.name}</code></h3>
              <p class="side-desc">{item.commandA.description}</p>
            </div>

            <div class="when-box">
              <div class="when-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>{isEn ? 'When to use:' : 'Cuándo usarlo:'}</span>
              </div>
              <p>{item.commandA.whenToUse}</p>
            </div>

            <div class="pros-cons">
              <div class="pros-list">
                <span class="pro-con-title text-emerald">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  {isEn ? 'Advantages:' : 'Ventajas:'}
                </span>
                <ul>
                  {item.commandA.pros.map(p => <li>{p}</li>)}
                </ul>
              </div>

              {item.commandA.cons.length > 0 && (
                <div class="cons-list">
                  <span class="pro-con-title text-rose">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    {isEn ? 'Trade-offs / Caveats:' : 'Desventajas / Precauciones:'}
                  </span>
                  <ul>
                    {item.commandA.cons.map(c => <li>{c}</li>)}
                  </ul>
                </div>
              )}
            </div>
          </div>

          <!-- Command B -->
          <div class="command-side side-b">
            <div class="side-header">
              <span class="side-badge badge-b">{isEn ? 'Option B' : 'Opción B'}</span>
              <h3 class="side-title"><code>{item.commandB.name}</code></h3>
              <p class="side-desc">{item.commandB.description}</p>
            </div>

            <div class="when-box">
              <div class="when-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>{isEn ? 'When to use:' : 'Cuándo usarlo:'}</span>
              </div>
              <p>{item.commandB.whenToUse}</p>
            </div>

            <div class="pros-cons">
              <div class="pros-list">
                <span class="pro-con-title text-emerald">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  {isEn ? 'Advantages:' : 'Ventajas:'}
                </span>
                <ul>
                  {item.commandB.pros.map(p => <li>{p}</li>)}
                </ul>
              </div>

              {item.commandB.cons.length > 0 && (
                <div class="cons-list">
                  <span class="pro-con-title text-rose">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    {isEn ? 'Trade-offs / Caveats:' : 'Desventajas / Precauciones:'}
                  </span>
                  <ul>
                    {item.commandB.cons.map(c => <li>{c}</li>)}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </div>

        <div class="takeaway-banner">
          <div class="takeaway-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <div class="takeaway-text">
            <strong>{isEn ? 'Key takeaway:' : 'Conclusión clave:'}</strong> {item.keyTakeaway}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .comparisons-section {
    margin: 4.5rem 0 3.5rem;
    scroll-margin-top: 5rem;
  }

  .badge-compare {
    color: var(--accent-purple);
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.25);
  }

  .compare-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 2rem;
  }

  .compare-tab-btn {
    all: unset;
    cursor: pointer;
    padding: 0.55rem 1.15rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 9999px;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .compare-tab-btn:hover {
    color: var(--text-main);
    border-color: var(--border-medium);
  }

  .compare-tab-btn.active {
    background: rgba(168, 85, 247, 0.15);
    border-color: var(--accent-purple);
    color: var(--accent-purple);
  }

  .compare-panel-card {
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1.5px solid var(--border-subtle);
    border-radius: 1.25rem;
    padding: 2rem 1.75rem;
    box-shadow: var(--shadow-md);
  }

  .compare-panel-card[hidden] {
    display: none;
  }

  .side-by-side-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
  }

  .command-side {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .side-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1rem;
  }

  .side-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(56, 189, 248, 0.15);
    color: var(--accent-cyan);
    margin-bottom: 0.5rem;
  }

  .badge-b {
    background: rgba(250, 204, 21, 0.15);
    color: var(--accent-gold);
  }

  .side-title code {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .side-desc {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-top: 0.4rem;
  }

  /* When Box */
  .when-box {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 0.65rem;
    padding: 0.75rem 0.9rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--text-main);
  }

  .when-label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 700;
    color: var(--accent-gold);
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  /* Pros Cons */
  .pros-cons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pro-con-title {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 0.45rem;
  }

  .text-emerald { color: var(--accent-emerald); }
  .text-rose { color: var(--accent-rose); }

  .pros-list ul,
  .cons-list ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .pros-list li,
  .cons-list li {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.4;
    padding-left: 0.85rem;
    position: relative;
  }

  .pros-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--accent-emerald);
  }

  .cons-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--accent-rose);
  }

  /* Takeaway Banner */
  .takeaway-banner {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border-radius: 0.85rem;
    background: rgba(168, 85, 247, 0.08);
    border: 1px solid rgba(168, 85, 247, 0.25);
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .takeaway-icon {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: rgba(168, 85, 247, 0.2);
    color: var(--accent-purple);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .takeaway-text {
    font-size: 0.9rem;
    color: var(--text-main);
    line-height: 1.45;
  }

  .takeaway-text strong {
    color: var(--accent-purple);
  }

  @media (max-width: 820px) {
    .side-by-side-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const cmpTabs = document.querySelectorAll<HTMLButtonElement>('.compare-tab-btn');
  const cmpPanels = document.querySelectorAll<HTMLElement>('.compare-panel-card');

  cmpTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      cmpTabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const targetId = tab.getAttribute('data-cmp-id');
      cmpPanels.forEach(panel => {
        const matches = panel.getAttribute('data-cmp-target') === targetId;
        panel.hidden = !matches;
      });
    });
  });
</script>
