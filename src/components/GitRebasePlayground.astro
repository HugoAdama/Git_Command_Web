---
// GitRebasePlayground.astro
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';
---

<section id="seccion-rebase-playground" class="rebase-playground-section" aria-label={isEn ? "Interactive git rebase simulator" : "Simulador de rebase interactivo"}>
  <div class="section-title-wrap">
    <div class="section-badge badge-rebase">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="18" cy="18" r="3"></circle>
        <circle cx="6" cy="6" r="3"></circle>
        <path d="M6 21V9a9 9 0 0 0 9 9"></path>
      </svg>
      <span>{isEn ? 'Interactive History Rewriting' : 'Reescritura Interactiva de Historia'}</span>
    </div>
    <h2 class="section-heading">{isEn ? 'Interactive Rebase Playground (git rebase -i)' : 'Playground de Rebase Interactivo (git rebase -i)'}</h2>
    <p class="section-sub">
      {isEn
        ? 'Experiment visually with interactive rebase. Reorder commits, squash bugfixes, reword messages, or drop commits without fear. Discover why Git recalculates SHA-1 hashes and creates a pristine linear history.'
        : 'Experimenta visualmente con el rebase interactivo. Reordena commits, fusiona arreglos rápidos con squash/fixup, edita mensajes o elimina cambios sin miedo. Descubre por qué Git recalcula los hashes SHA y crea un historial lineal limpio.'}
    </p>
  </div>

  <div class="rebase-card">
    <!-- Top toolbar & presets -->
    <div class="rebase-toolbar">
      <div class="terminal-cmd-badge">
        <span class="prompt-sym">$</span>
        <code>git rebase -i HEAD~4</code>
      </div>
      <div class="rebase-actions-bar">
        <button type="button" id="preset-squash-btn" class="rebase-preset-btn">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="4 14 10 14 10 20"></polyline>
            <polyline points="20 10 14 10 14 4"></polyline>
            <line x1="14" y1="10" x2="21" y2="3"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <span>{isEn ? 'Preset: Squash Fix' : 'Preset: Squash Fix'}</span>
        </button>
        <button type="button" id="reset-rebase-btn" class="rebase-reset-btn" title={isEn ? "Reset commits to initial state" : "Restablecer commits a su estado original"}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
          </svg>
          <span>{isEn ? 'Reset' : 'Restablecer'}</span>
        </button>
      </div>
    </div>

    <!-- Commits Interactive Ordering & Action List -->
    <div class="commits-list-container">
      <div class="commits-list-header">
        <span class="col-order">{isEn ? 'Order' : 'Orden'}</span>
        <span class="col-action">{isEn ? 'Action (Command)' : 'Acción (Comando)'}</span>
        <span class="col-sha">{isEn ? 'Hash' : 'Hash'}</span>
        <span class="col-msg">{isEn ? 'Commit Message' : 'Mensaje del Commit'}</span>
      </div>

      <div id="rebase-commits-list" class="commits-list-body">
        <!-- Rendered via JavaScript -->
      </div>
    </div>

    <!-- Rebase Todo Editor Preview -->
    <div class="rebase-todo-box">
      <div class="todo-box-header">
        <span class="todo-dot dot-red"></span>
        <span class="todo-dot dot-yellow"></span>
        <span class="todo-dot dot-green"></span>
        <span class="todo-title">.git/rebase-merge/git-rebase-todo (vim buffer)</span>
      </div>
      <pre class="todo-content"><code id="rebase-todo-preview"># git-rebase-todo preview</code></pre>
    </div>

    <!-- Simulation Trigger Button -->
    <div class="rebase-footer-controls">
      <button type="button" id="execute-rebase-btn" class="execute-rebase-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span>{isEn ? 'Simulate Rebase Execution' : 'Ejecutar Rebase Simulado'}</span>
      </button>
    </div>

    <!-- Simulation Result & DAG Comparison -->
    <div id="rebase-result-area" class="rebase-result-area" hidden>
      <div class="result-banner">
        <div class="result-badge-success">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{isEn ? 'Successfully rebased and updated refs/heads/feature!' : '¡Rebase completado y refs/heads/feature actualizado con éxito!'}</span>
        </div>
        <p id="rebase-explanation-text" class="result-desc"></p>
      </div>

      <div class="dag-comparison-grid">
        <div class="dag-box before-box">
          <span class="dag-label">{isEn ? 'Before Rebase (Old History):' : 'Antes del Rebase (Historial Antiguo):'}</span>
          <div id="dag-before-list" class="dag-nodes"></div>
        </div>
        <div class="dag-arrow" aria-hidden="true">➔</div>
        <div class="dag-box after-box">
          <span class="dag-label">{isEn ? 'After Rebase (Rewritten Clean History):' : 'Después del Rebase (Historial Limpio Reescrito):'}</span>
          <div id="dag-after-list" class="dag-nodes"></div>
        </div>
      </div>
    </div>

    <!-- Golden Rule Warning -->
    <div class="golden-rule-box">
      <div class="rule-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
      </div>
      <div class="rule-text">
        <strong>{isEn ? 'Golden Rule of Rebase:' : 'La Regla de Oro del Rebase:'}</strong>
        <span>
          {isEn
            ? 'Never rebase commits that have already been pushed to a public or shared branch (e.g. main/production). Rebasing rewrites SHA-1 hashes, which forces other contributors into painful synchronization conflicts.'
            : 'Nunca hagas rebase de commits que ya hayas subido (push) a una rama pública o compartida (como main o production). El rebase altera los hashes SHA-1, lo cual obligará a tus compañeros a resolver conflictos de sincronización innecesarios.'}
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .rebase-playground-section {
    margin: 3.5rem 0;
    scroll-margin-top: 5rem;
  }

  .section-title-wrap {
    margin-bottom: 2rem;
  }

  .badge-rebase {
    background: rgba(168, 85, 247, 0.12);
    border-color: rgba(168, 85, 247, 0.3);
    color: var(--accent-purple);
  }

  .rebase-card {
    background: var(--bg-card);
    border: 1px solid var(--border-medium);
    border-radius: 1.25rem;
    padding: 1.75rem;
    box-shadow: var(--shadow-md);
  }

  .rebase-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-cmd-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid var(--border-subtle);
    border-radius: 0.5rem;
    padding: 0.4rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .terminal-cmd-badge .prompt-sym {
    color: var(--accent-emerald);
    font-weight: 700;
  }

  .rebase-actions-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .rebase-preset-btn,
  .rebase-reset-btn {
    all: unset;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.825rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .rebase-preset-btn {
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: var(--accent-purple);
  }

  .rebase-preset-btn:hover {
    background: rgba(168, 85, 247, 0.25);
    transform: translateY(-1px);
  }

  .rebase-reset-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }

  .rebase-reset-btn:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.1);
  }

  /* Commits Table / List */
  .commits-list-container {
    background: rgba(10, 16, 30, 0.6);
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    overflow: hidden;
    margin-bottom: 1.25rem;
  }

  .commits-list-header {
    display: grid;
    grid-template-columns: 85px 140px 95px 1fr;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .commits-list-body {
    display: flex;
    flex-direction: column;
  }

  :global(.commit-rebase-row) {
    display: grid;
    grid-template-columns: 85px 140px 95px 1fr;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    transition: background 0.15s ease;
  }

  :global(.commit-rebase-row:last-child) {
    border-bottom: none;
  }

  :global(.commit-rebase-row:hover) {
    background: rgba(255, 255, 255, 0.02);
  }

  :global(.rebase-order-controls) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  :global(.order-btn) {
    all: unset;
    cursor: pointer;
    width: 1.6rem;
    height: 1.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    transition: all 0.15s ease;
  }

  :global(.order-btn:hover:not(:disabled)) {
    background: var(--accent-cyan);
    color: #070b14;
    border-color: var(--accent-cyan);
  }

  :global(.order-btn:disabled) {
    opacity: 0.25;
    cursor: not-allowed;
  }

  :global(.rebase-action-select) {
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid var(--border-medium);
    border-radius: 0.45rem;
    color: var(--text-main);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 0.5rem;
    cursor: pointer;
    outline: none;
  }

  :global(.rebase-action-select:focus) {
    border-color: var(--accent-cyan);
  }

  :global(.commit-hash-tag) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-gold);
    background: rgba(250, 204, 21, 0.1);
    border: 1px solid rgba(250, 204, 21, 0.25);
    padding: 0.2rem 0.45rem;
    border-radius: 0.35rem;
    text-align: center;
  }

  :global(.commit-msg-input) {
    width: 100%;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.35rem;
    padding: 0.35rem 0.6rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--text-main);
    transition: all 0.2s ease;
  }

  :global(.commit-msg-input:focus),
  :global(.commit-rebase-row.is-reword .commit-msg-input) {
    background: rgba(15, 23, 42, 0.8);
    border-color: var(--accent-gold);
  }

  :global(.commit-rebase-row.is-drop) {
    opacity: 0.45;
    text-decoration: line-through;
  }

  :global(.commit-rebase-row.is-squash .commit-msg-input),
  :global(.commit-rebase-row.is-fixup .commit-msg-input) {
    color: var(--text-muted);
    font-style: italic;
  }

  /* Todo preview buffer */
  .rebase-todo-box {
    background: #060911;
    border: 1px solid var(--border-medium);
    border-radius: 0.75rem;
    overflow: hidden;
    margin-bottom: 1.25rem;
  }

  .todo-box-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-subtle);
  }

  .todo-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
  }

  .dot-red { background: #f43f5e; }
  .dot-yellow { background: #facc15; }
  .dot-green { background: #10b981; }

  .todo-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    margin-left: 0.5rem;
  }

  .todo-content {
    margin: 0;
    padding: 0.85rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
    overflow-x: auto;
  }

  .rebase-footer-controls {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1.25rem;
  }

  .execute-rebase-btn {
    all: unset;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, var(--accent-purple), #7e22ce);
    color: #ffffff;
    padding: 0.65rem 1.4rem;
    border-radius: 0.6rem;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    box-shadow: 0 4px 15px -3px rgba(168, 85, 247, 0.4);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .execute-rebase-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px -3px rgba(168, 85, 247, 0.6);
  }

  /* Result Area */
  .rebase-result-area {
    margin-top: 1.5rem;
    padding: 1.5rem;
    background: rgba(16, 185, 129, 0.05);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 0.85rem;
    animation: fadeInResult 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeInResult {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .result-banner {
    margin-bottom: 1.25rem;
  }

  .result-badge-success {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-emerald);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .result-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .dag-comparison-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .dag-box {
    background: rgba(10, 16, 30, 0.8);
    border: 1px solid var(--border-subtle);
    border-radius: 0.65rem;
    padding: 1rem;
  }

  .dag-label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.775rem;
    font-weight: 700;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  :global(.dag-node-item) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.6rem;
    margin-bottom: 0.4rem;
    border-radius: 0.45rem;
    background: rgba(255, 255, 255, 0.03);
    font-family: var(--font-mono);
    font-size: 0.775rem;
  }

  :global(.dag-node-item:last-child) {
    margin-bottom: 0;
  }

  :global(.dag-sha-pill) {
    color: var(--accent-cyan);
    font-weight: 700;
  }

  :global(.dag-msg-text) {
    color: var(--text-main);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.dag-box.after-box .dag-sha-pill) {
    color: var(--accent-emerald);
  }

  .dag-arrow {
    font-size: 1.5rem;
    color: var(--accent-emerald);
  }

  /* Golden Rule Box */
  .golden-rule-box {
    margin-top: 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem;
    background: rgba(244, 63, 94, 0.06);
    border: 1px solid rgba(244, 63, 94, 0.25);
    border-radius: 0.65rem;
  }

  .rule-icon {
    color: var(--accent-rose);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .rule-text {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .rule-text strong {
    color: var(--accent-rose);
    display: block;
    margin-bottom: 0.15rem;
  }

  @media (max-width: 768px) {
    .commits-list-header {
      display: none;
    }

    :global(.commit-rebase-row) {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      padding: 0.85rem 0.75rem;
    }

    :global(.commit-rebase-row .col-msg) {
      grid-column: span 2;
    }

    .dag-comparison-grid {
      grid-template-columns: 1fr;
    }

    .dag-arrow {
      text-align: center;
      transform: rotate(90deg);
    }
  }
</style>

<script>
  // Rebase Playground State & Logic
  interface CommitItem {
    id: string;
    originalSha: string;
    action: 'pick' | 'reword' | 'squash' | 'fixup' | 'drop';
    message: string;
    author: string;
  }

  const initialCommits: CommitItem[] = [
    { id: '1', originalSha: 'c1a2f3e', action: 'pick', message: 'feat(auth): initial login endpoint', author: 'Hugo Adama' },
    { id: '2', originalSha: '9b8c7d6', action: 'pick', message: 'fix: typo in jwt token expiration logic', author: 'Hugo Adama' },
    { id: '3', originalSha: '4e5d6c7', action: 'pick', message: 'test: add unit tests for auth flow', author: 'Hugo Adama' },
    { id: '4', originalSha: '8f7e6d5', action: 'pick', message: 'docs: document login api endpoints', author: 'Hugo Adama' }
  ];

  let commits: CommitItem[] = JSON.parse(JSON.stringify(initialCommits));

  const listContainer = document.getElementById('rebase-commits-list');
  const todoPreview = document.getElementById('rebase-todo-preview');
  const executeBtn = document.getElementById('execute-rebase-btn');
  const resultArea = document.getElementById('rebase-result-area');
  const explanationText = document.getElementById('rebase-explanation-text');
  const dagBefore = document.getElementById('dag-before-list');
  const dagAfter = document.getElementById('dag-after-list');
  const resetBtn = document.getElementById('reset-rebase-btn');
  const presetSquashBtn = document.getElementById('preset-squash-btn');

  function renderList() {
    if (!listContainer) return;
    listContainer.innerHTML = '';

    commits.forEach((commit, index) => {
      const row = document.createElement('div');
      row.className = `commit-rebase-row action-${commit.action} ${commit.action === 'reword' ? 'is-reword' : ''} ${commit.action === 'drop' ? 'is-drop' : ''} ${commit.action === 'squash' ? 'is-squash' : ''} ${commit.action === 'fixup' ? 'is-fixup' : ''}`;

      // 1. Order controls
      const orderCol = document.createElement('div');
      orderCol.className = 'rebase-order-controls';
      orderCol.innerHTML = `
        <button type="button" class="order-btn btn-up" title="Move up" ${index === 0 ? 'disabled' : ''}>↑</button>
        <button type="button" class="order-btn btn-down" title="Move down" ${index === commits.length - 1 ? 'disabled' : ''}>↓</button>
      `;

      orderCol.querySelector('.btn-up')?.addEventListener('click', () => {
        if (index > 0) {
          const temp = commits[index];
          commits[index] = commits[index - 1];
          commits[index - 1] = temp;
          renderList();
          updateTodoPreview();
        }
      });

      orderCol.querySelector('.btn-down')?.addEventListener('click', () => {
        if (index < commits.length - 1) {
          const temp = commits[index];
          commits[index] = commits[index + 1];
          commits[index + 1] = temp;
          renderList();
          updateTodoPreview();
        }
      });

      // 2. Action Select
      const actionSelect = document.createElement('select');
      actionSelect.className = 'rebase-action-select';
      const actions = ['pick', 'reword', 'squash', 'fixup', 'drop'];
      actions.forEach((act) => {
        const opt = document.createElement('option');
        opt.value = act;
        opt.textContent = act;
        if (act === commit.action) opt.selected = true;
        actionSelect.appendChild(opt);
      });

      actionSelect.addEventListener('change', (e) => {
        commit.action = (e.target as HTMLSelectElement).value as any;
        renderList();
        updateTodoPreview();
      });

      // 3. Hash Tag
      const hashSpan = document.createElement('span');
      hashSpan.className = 'commit-hash-tag';
      hashSpan.textContent = commit.originalSha;

      // 4. Message Input
      const msgInput = document.createElement('input');
      msgInput.type = 'text';
      msgInput.className = 'commit-msg-input';
      msgInput.value = commit.message;
      msgInput.placeholder = 'Commit description';
      msgInput.addEventListener('input', (e) => {
        commit.message = (e.target as HTMLInputElement).value;
        updateTodoPreview();
      });

      row.appendChild(orderCol);
      row.appendChild(actionSelect);
      row.appendChild(hashSpan);
      row.appendChild(msgInput);

      listContainer.appendChild(row);
    });

    updateTodoPreview();
  }

  function updateTodoPreview() {
    if (!todoPreview) return;
    const lines = commits.map(c => `${c.action.padEnd(7)} ${c.originalSha} ${c.message}`);
    const comments = [
      '',
      '# Rebase a84f91d..8f7e6d5 onto a84f91d (4 commands)',
      '# Commands: pick, reword, edit, squash, fixup, exec, drop',
      '# Note: these lines can be re-ordered; they are executed from top to bottom.'
    ];
    todoPreview.textContent = [...lines, ...comments].join('\n');
  }

  function simulateRebase() {
    if (!resultArea || !explanationText || !dagBefore || !dagAfter) return;

    // Build Before DAG
    dagBefore.innerHTML = '';
    initialCommits.forEach(c => {
      const item = document.createElement('div');
      item.className = 'dag-node-item';
      item.innerHTML = `<span class="dag-sha-pill">${c.originalSha}</span><span class="dag-msg-text">${c.message}</span>`;
      dagBefore.appendChild(item);
    });

    // Execute Rebase Algorithm
    dagAfter.innerHTML = '';
    const newHistory: { sha: string; message: string; type: string }[] = [];
    const shaGenerator = () => {
      const hex = '0123456789abcdef';
      let out = '';
      for (let i = 0; i < 7; i++) out += hex[Math.floor(Math.random() * hex.length)];
      return out;
    };

    let squashedCount = 0;
    let droppedCount = 0;

    commits.forEach((c) => {
      if (c.action === 'drop') {
        droppedCount++;
        return;
      }

      if ((c.action === 'squash' || c.action === 'fixup') && newHistory.length > 0) {
        squashedCount++;
        const prev = newHistory[newHistory.length - 1];
        if (c.action === 'squash') {
          prev.message += ` + ${c.message}`;
        }
        // Hash recalculates when content changes
        prev.sha = shaGenerator(prev.sha);
      } else {
        // Normal pick or reword
        newHistory.push({
          sha: shaGenerator(c.originalSha),
          message: c.message,
          type: c.action
        });
      }
    });

    newHistory.forEach(h => {
      const item = document.createElement('div');
      item.className = 'dag-node-item';
      item.innerHTML = `<span class="dag-sha-pill">${h.sha}</span><span class="dag-msg-text">${h.message}</span>`;
      dagAfter.appendChild(item);
    });

    explanationText.innerHTML = `
      Git reescribió la secuencia de 4 commits: <strong>${newHistory.length} commits resultantes</strong>, 
      ${squashedCount} fusionado(s) y ${droppedCount} descartado(s). 
      Observa cómo <strong>todos los hashes SHA cambiaron</strong> porque un commit en Git es inmutable y su hash depende directamente del árbol y del commit padre.
    `;

    resultArea.hidden = false;
    resultArea.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  executeBtn?.addEventListener('click', simulateRebase);

  resetBtn?.addEventListener('click', () => {
    commits = JSON.parse(JSON.stringify(initialCommits));
    renderList();
    if (resultArea) resultArea.hidden = true;
  });

  presetSquashBtn?.addEventListener('click', () => {
    commits = JSON.parse(JSON.stringify(initialCommits));
    // Set commit 2 (fix) to fixup
    if (commits[1]) commits[1].action = 'fixup';
    renderList();
  });

  // Initial render
  renderList();
</script>
